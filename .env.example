# Frontend (Vite) — copy to `.env` or `.env.local`
# Convex deployment (WebSocket + queries/mutations)
VITE_CONVEX_URL=https://quaint-jellyfish-856.eu-west-1.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex HTTP actions base (only if you add httpRouter routes; not used by ConvexClient)
# https://docs.convex.dev/functions/http-actions
CONVEX_HTTP_SITE_URL=https://quaint-jellyfish-856.eu-west-1.convex.site

# Convex backend (set in Convex Dashboard → Settings → Environment Variables,
# and/or in `.env.local` for `pnpm exec convex dev` when the CLI reads them)
# Clerk Frontend API URL from the Clerk dashboard (e.g. https://happy-mole-12.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Optional: if your tooling exports deployment selection for the Convex CLI
# CONVEX_DEPLOYMENT=dev:your-deployment-name

# This repo checks in convex/_generated so `pnpm run build` works without linking
# Convex first. After you change convex/schema.ts or handlers, run
# `pnpm exec convex dev` (or `pnpm exec convex codegen`) and commit the updated
# generated files. If you prefer to gitignore convex/_generated, add that path
# to .gitignore and run codegen before every build in CI/local.
